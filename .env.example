# --- Режим торговли ---
# PAPER_MODE=true  → сделки симулируются (без реальных денег). Рекомендуется.
# PAPER_MODE=false → реальные ордера через CLOB (нужны ключи POLY_* ниже).
PAPER_MODE=true
TRADE_AMOUNT_USD=2.0

# --- Telegram (модуль уведомлений) ---
# Без этих двух переменных алерты идут только в лог.
TELEGRAM_TOKEN=токен_от_BotFather
TELEGRAM_CHAT_ID=твой_chat_id

# --- Whale Scouter (опционально, есть дефолты) ---
# SCOUT_MIN_WINRATE=0.80
# SCOUT_MIN_PNL=100000
# MIN_ALERT_NOTIONAL=1000

# --- Filter Engine / вход в сделку (опционально, есть дефолты) ---
# TRUSTED_WHALE_MIN_NOTIONAL=1000   # одиночный сигнал кита: минимальный размер его сделки, $
# MAX_PRICE=0.80                    # не входить, если ask выше (апсайд мизерный, риск -100%)
# MAX_ENTRY_SLIPPAGE=0.05           # рынок убежал от цены кита больше чем на N центов → пропуск

# --- Polymarket LIVE-трейдинг (только при PAPER_MODE=false) ---
POLY_PRIVATE_KEY=приватный_ключ_кошелька_polygon
POLY_PROXY_ADDRESS=адрес_прокси_кошелька_polymarket
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
