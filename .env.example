# --- Режим торговли ---
# PAPER_MODE=true  → сделки симулируются (без реальных денег). Рекомендуется.
# PAPER_MODE=false → реальные ордера через CLOB (нужны ключи POLY_* ниже).
PAPER_MODE=true
TRADE_AMOUNT_USD=2.0

# --- Telegram (модуль уведомлений) ---
# Без этих двух переменных алерты идут только в лог.
TELEGRAM_TOKEN=токен_от_BotFather
TELEGRAM_CHAT_ID=твой_chat_id

# --- Whale Scouter (опционально, есть дефолты) ---
# SCOUT_MIN_WINRATE=0.80
# SCOUT_MIN_PNL=100000
# MIN_ALERT_NOTIONAL=1000

# --- Filter Engine / вход в сделку (опционально, есть дефолты) ---
# TRUSTED_WHALE_MIN_NOTIONAL=1000   # одиночный сигнал кита: минимальный размер его сделки, $
# MAX_PRICE=0.80                    # не входить, если ask выше (апсайд мизерный, риск -100%)
# MAX_ENTRY_SLIPPAGE=0.05           # рынок убежал от цены кита больше чем на N центов → пропуск

# --- Управление капиталом (опционально, есть дефолты) ---
# MAX_OPEN_POSITIONS=10             # лимит одновременных позиций
# POSITION_MAX_PCT=0.02             # максимум банкролла на одну позицию (2%)
# POSITION_MAX_PCT_CHEAP=0.04       # повышенный кап для дешёвых входов (<CHEAP_ENTRY_MAX)
# DAILY_MAX_LOSS_PCT=0.05           # дневная просадка >= 5% → пауза входов до завтра UTC
# PAPER_START_BALANCE=1000          # стартовый банк симуляции (масштаб капитала)
# KELLY_FRACTION=0.25               # доля полного Келли (выше = агрессивнее сайзинг)

# --- Профиль выхода и фильтры сигнала (Патчи A/B/C, есть дефолты) ---
# TAKE_PROFIT_DELTA=0.10            # базовый TP в пунктах вероятности (центах)
# STOP_LOSS_DELTA=-0.15             # SL в пунктах вероятности
# CHEAP_ENTRY_MAX=0.35             # вход ниже → дешёвый лонгшот: флип ВЫКЛ, широкий TP
# CHEAP_TAKE_PROFIT_DELTA=0.45      # TP для дешёвых входов (даём хвосту ехать)
# SINGLE_WHALE_MAX_PRICE=0.50       # одиночный кит выше этой цены → скип (фавориты только консенсусом)
# SINGLE_WHALE_ALLOW_SELL=false     # true → разрешить одиночному киту сигналить SELL
# SKIP_WHEN_NO_EDGE=true            # одиночный кит без края (WinRate <= цена) → скип

# --- Polymarket LIVE-трейдинг (только при PAPER_MODE=false) ---
POLY_PRIVATE_KEY=приватный_ключ_кошелька_polygon
POLY_PROXY_ADDRESS=адрес_прокси_кошелька_polymarket
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
